# Dependencies
node_modules/

# Build output
dist/

# Test results and reports
allure-results/
allure-report/
logs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.test
.env.test.*
.env.demo
.env.*.local

# App binaries (add your actual APK/IPA files)
apps/*.apk
apps/*.ipa
apps/*.app

# Keep apps folder structure
!apps/.gitkeep

# Coverage
coverage/

# Test database state (local tracking of which env breakroom_test is configured for)
database/.db-state.json

# Temporary files
*.log
*.backup
tmp/
temp/

# Demo recordings (large video files)
demos/recordings/*.mp4
demos/recordings/*.mov
!demos/recordings/.gitkeep
