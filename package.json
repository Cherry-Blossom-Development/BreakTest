{
  "name": "breaktest",
  "version": "1.0.0",
  "description": "End-to-end test automation framework for Breakroom - Web (Selenium) and Mobile (Appium)",
  "main": "index.js",
  "scripts": {
    "db:setup": "ts-node database/setup.ts",
    "db:reset": "ts-node database/setup.ts",
    "db:sync-schema": "ts-node database/sync-schema.ts",
    "db:sync-schema:dry-run": "ts-node database/sync-schema.ts --dry-run --verbose",
    "test:env:start": "bash scripts/start-test-env.sh",
    "test:env:stop": "bash scripts/stop-test-env.sh",
    "test:web": "wdio run ./config/wdio.web.conf.ts",
    "test:web:headless": "HEADLESS=true wdio run ./config/wdio.web.conf.ts",
    "test:web:fresh": "npm run db:setup && npm run test:web",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:all": "npm run test:web && npm run test:android",
    "start:app": "./scripts/run-tests.sh --stop",
    "test:with-app": "./scripts/run-tests.sh web",
    "test:with-app:headless": "./scripts/run-tests.sh web:headless",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "lint": "tsc --noEmit",
    "clean": "rm -rf allure-results allure-report dist logs"
  },
  "keywords": [
    "testing",
    "automation",
    "webdriverio",
    "appium",
    "selenium",
    "typescript"
  ],
  "author": "Cherry Blossom Development",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.4.7",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.9",
    "@wdio/allure-reporter": "^9.23.2",
    "@wdio/appium-service": "^9.23.2",
    "@wdio/cli": "^9.23.2",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.23.2",
    "@wdio/mocha-framework": "^9.23.2",
    "@wdio/reporter": "^9.23.2",
    "@wdio/spec-reporter": "^9.23.2",
    "@wdio/types": "^9.23.2",
    "allure-commandline": "^2.36.0",
    "appium": "^3.1.2",
    "chromedriver": "^144.0.0",
    "expect-webdriverio": "^5.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^9.23.2"
  }
}
