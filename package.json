{
  "name": "breaktest",
  "version": "1.0.0",
  "description": "End-to-end test automation framework for Breakroom - Web (Selenium) and Mobile (Appium)",
  "main": "index.js",
  "scripts": {
    "db:setup": "TEST_ENV=dev ts-node database/setup.ts",
    "db:setup:dev": "TEST_ENV=dev ts-node database/setup.ts",
    "db:setup:production": "TEST_ENV=production ts-node database/setup.ts",
    "db:reset": "TEST_ENV=dev ts-node database/setup.ts",
    "db:sync-schema": "TEST_ENV=dev ts-node database/sync-schema.ts",
    "db:sync-schema:dev": "TEST_ENV=dev ts-node database/sync-schema.ts",
    "db:sync-schema:production": "TEST_ENV=production ts-node database/sync-schema.ts",
    "db:sync-schema:dry-run": "TEST_ENV=dev ts-node database/sync-schema.ts --dry-run --verbose",
    "db:state": "node -e \"const f='database/.db-state.json'; const fs=require('fs'); fs.existsSync(f) ? console.log(JSON.stringify(JSON.parse(fs.readFileSync(f,'utf8')),null,2)) : console.log('No state file — run db:sync-schema or db:setup first')\"",
    "test:env:start": "bash scripts/start-test-env.sh",
    "test:env:stop": "bash scripts/stop-test-env.sh",
    "test:web": "TEST_ENV=dev wdio run ./config/wdio.web.conf.ts",
    "test:web:dev": "TEST_ENV=dev wdio run ./config/wdio.web.conf.ts",
    "test:web:production": "TEST_ENV=production wdio run ./config/wdio.web.conf.ts",
    "test:web:headless": "HEADLESS=true TEST_ENV=dev wdio run ./config/wdio.web.conf.ts",
    "test:web:dev:headless": "HEADLESS=true TEST_ENV=dev wdio run ./config/wdio.web.conf.ts",
    "test:web:production:headless": "HEADLESS=true TEST_ENV=production wdio run ./config/wdio.web.conf.ts",
    "test:web:fresh": "npm run db:setup && npm run test:web:dev",
    "test:android": "TEST_ENV=dev wdio run ./config/wdio.android.conf.ts",
    "test:android:dev": "TEST_ENV=dev wdio run ./config/wdio.android.conf.ts",
    "test:android:production": "TEST_ENV=production wdio run ./config/wdio.android.conf.ts",
    "test:ios": "TEST_ENV=dev wdio run ./config/wdio.ios.conf.ts",
    "test:ios:dev": "TEST_ENV=dev wdio run ./config/wdio.ios.conf.ts",
    "test:ios:production": "TEST_ENV=production wdio run ./config/wdio.ios.conf.ts",
    "test:all": "npm run test:web:dev && npm run test:android:dev",
    "test:all:production": "npm run test:web:production && npm run test:android:production",
    "start:app": "./scripts/run-tests.sh --stop",
    "test:with-app": "./scripts/run-tests.sh web",
    "test:with-app:headless": "./scripts/run-tests.sh web:headless",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "lint": "tsc --noEmit",
    "clean": "rm -rf allure-results allure-report dist logs",
    "demo:db:setup": "ts-node database/setup.ts",
    "demo:record": "wdio run ./demos/config/wdio.demo.conf.ts",
    "demo:record:script": "wdio run ./demos/config/wdio.demo.conf.ts --spec"
  },
  "keywords": [
    "testing",
    "automation",
    "webdriverio",
    "appium",
    "selenium",
    "typescript"
  ],
  "author": "Cherry Blossom Development",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.4.7",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.9",
    "@wdio/allure-reporter": "^9.23.2",
    "@wdio/appium-service": "^9.23.2",
    "@wdio/cli": "^9.23.2",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.23.2",
    "@wdio/mocha-framework": "^9.23.2",
    "@wdio/reporter": "^9.23.2",
    "@wdio/spec-reporter": "^9.23.2",
    "@wdio/types": "^9.23.2",
    "allure-commandline": "^2.36.0",
    "appium": "^3.1.2",
    "appium-xcuitest-driver": "^10.26.0",
    "chromedriver": "^144.0.0",
    "expect-webdriverio": "^5.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^9.23.2"
  }
}
