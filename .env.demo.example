# Demo Environment Configuration
# Copy this file to .env.demo and fill in values

# Demo Database (uses test database)
TEST_DB_HOST=your_db_host
TEST_DB_PORT=3306
TEST_DB_USER=your_db_user
TEST_DB_PASS=your_db_password
TEST_DB_NAME=breakroom_test

# Demo API (runs locally, points to test database)
DEMO_API_URL=http://localhost:3001

# iOS Simulator Settings
DEMO_DEVICE_NAME=iPhone 15 Pro
DEMO_PLATFORM_VERSION=17.0

# Demo App Path (built with Demo scheme)
DEMO_APP_PATH=./apps/Breakroom-Demo.app
