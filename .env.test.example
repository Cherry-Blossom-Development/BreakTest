# Test Database Configuration
# Copy this file to .env.test and fill in the values

# Test database connection (separate from production!)
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASS=your_password_here
TEST_DB_NAME=breakroom_test

# Application base URL for tests
BASE_URL=https://local.prosaurus.com

# Breakroom Test Results Reporter
# API endpoint where test results are sent
BREAKROOM_API_URL=https://local.prosaurus.com/api/test-results
# Optional API key (set TEST_API_KEY in Breakroom backend to require this)
BREAKROOM_TEST_API_KEY=
# Environment name for test results (local, staging, production)
TEST_ENVIRONMENT=local
